# Whitelist: only source, tools, docs and branding go in the repo.
/*
!/.gitignore
!/README.txt
!/README.md
!/STORE_SETUP.md
!/VOTE_SETUP.md
!/WEBSITE_SETUP.md
!/start-alloymc.bat
!/stop-alloymc.bat
!/plugins-src/
!/tools/
!/datapacks/
!/resourcepack/
!/branding/
!/website/
!/docs/
!/.github/

# build output and caches
# Gradle output only. (A plugins-src/**/build/ rule would also hide the source package net/alloymc/core/build/.)
plugins-src/*/build/
plugins-src/**/.gradle/
plugins-src/**/out/

# tools: bundled JDK/Gradle, secrets, logs, node deps
tools/jdk-*/
tools/gradle-*/
tools/rcon.secret
tools/*.log
tools/**/node_modules/
tools/**/*.log
tools/__pycache__/
*.secret
tools/autoupdate.lock
tools/restart-requests/
tools/automerge_state.json

# renders of the live worlds and the trailer's frames: big, and rebuilt any time with gradle shots / gradle trailer
plugins-src/AlloyCore/previews/live/
plugins-src/AlloyCore/previews/trailer/
